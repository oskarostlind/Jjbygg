# Neon DB (PostgreSQL)
# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
# Vercel Blob – hämtas från Vercel Dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resend – e-post
RESEND_API_KEY="re_..."

# E-post (Resend – domän info@jjbyggboden.se måste vara verifierad i Resend)
JESPER_EMAIL="info@jjbyggboden.se"
FROM_EMAIL="JJ Bygg & Entreprenad <info@jjbyggboden.se>"
# Telefon (footer + JSON-LD). Server-only: sätts i .env / Vercel Environment Variables (ingen NEXT_PUBLIC_).
# Format: 070-535 71 94 eller +46 70 535 71 94
CONTACT_NUMBER="070-535 71 94"

# Webbadress (byt till din Strato-domän när den finns)
# Används inte längre för canonical – kanonisk adress är hårdkodad i lib/seo.ts
NEXT_PUBLIC_SITE_URL="https://www.jjbyggboden.se"

# Valfritt: Google Search Console-verifiering via HTML-tagg (värdet ur "content" i metataggen
# Google ger dig). Alternativ: DNS TXT-post hos Strato – då behövs inte den här.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="..."

# Valfritt: Google Tag Manager (sätts i Vercel Environment Variables)
# Format: GTM-XXXXXXX
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# sitecms (innehåll + offertförfrågningar). Sätts i Vercel Environment Variables.
# Utan dem visas innehållet i lib/site-content.ts och förfrågningar sparas bara i Neon.
# CMS_API_URL="https://sitecms.se"
# CMS_API_KEY="..."

# Offertförfrågningar skrivs dubbelt: Neon (Prisma) + sitecms (panelen → Förfrågningar),
# och sajten mejlar själv via Resend (bekräftelse till kunden + notifiering till JESPER_EMAIL).
# VIKTIGT: Sätt INTE "E-post för förfrågningar" i sitecms-panelen för jjbygg så länge
# sajtens egna Resend-mejl är på – annars mejlar även sitecms företaget + kvitto till
# kunden och Jesper får dubbla mejl. (Lämnas fältet tomt sparas förfrågan i panelen
# utan att sitecms mejlar; emailStatus blir "skipped".)

# Salt för hashIp() (sitecms-next): sitecms rate-limitar offertförfrågningar per saltad
# IP-hash utan att se IP-adressen. Valfritt – saknas saltet skickas förfrågan utan ipHash
# (ingen rate limit i CMS:et). Generera ett slumpat värde, t.ex. `openssl rand -hex 32`,
# och sätt det i Vercel. Byt salt → gamla hashar blir värdelösa (ofarligt).
# IP_HASH_SALT="..."

# Felsökning av CMS-kopplingen: med OFFERT_DEBUG="1" loggar server actionen hela
# payloaden som skickas till sitecms (innehåller personuppgifter – aldrig i produktion).
# OFFERT_DEBUG="1"

# Live-förhandsgranskning i sitecms-panelen (sitecms-next 0.4) – ingen egen variabel behövs,
# samma CMS_API_URL och CMS_API_KEY används:
# - app/api/sitecms/preview/route.ts verifierar panelens token och slår på draft mode;
#   <SitecmsPreview /> sist i app/layout.tsx pratar med panelen (renderar inget för vanliga besökare).
# - lib/cms.ts hämtar osparade ändringar (x-sitecms-preview, utan cache) bara i förhandsgranskningen;
#   annars är hämtningen som förut (revalidate 60, tagg "cms").
# - Redigerbara texter/bilder markeras med editable("home", "nyckel") → data-sitecms="home:nyckel".
# - next.config.mjs: CSP frame-ancestors tillåter sitecms.se, www.sitecms.se och sitecms-zeta.vercel.app
#   (+ http://localhost:3000 i next dev). Sätt aldrig X-Frame-Options – då kan panelen inte visa sajten.
# - I förhandsgranskningen laddas inte Google Tag Manager eller leadkällespårningen, och offertformuläret
#   är avstängt (notis i UI:t, server action vägrar). /api/sitecms/preview?disable=1 stänger av.
# - Panelen behöver sajtens adress: sitecms → Inställningar → "Adress för förhandsgranskning" (om domänen
#   inte redan är ifylld).
