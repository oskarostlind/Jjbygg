# Neon DB (PostgreSQL)
# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
# Vercel Blob – hämtas från Vercel Dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resend – e-post
RESEND_API_KEY="re_..."

# E-post (Resend – domän info@jjbyggboden.se måste vara verifierad i Resend)
JESPER_EMAIL="info@jjbyggboden.se"
FROM_EMAIL="JJ Bygg & Entreprenad <info@jjbyggboden.se>"
# Telefon (footer + JSON-LD). Server-only: sätts i .env / Vercel Environment Variables (ingen NEXT_PUBLIC_).
# Format: 070-535 71 94 eller +46 70 535 71 94
CONTACT_NUMBER="070-535 71 94"

# Webbadress (byt till din Strato-domän när den finns)
# Används inte längre för canonical – kanonisk adress är hårdkodad i lib/seo.ts
NEXT_PUBLIC_SITE_URL="https://www.jjbyggboden.se"

# Valfritt: Google Tag Manager (sätts i Vercel Environment Variables)
# Format: GTM-XXXXXXX
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
